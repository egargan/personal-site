---
import CodeBlock from "$components/blog/CodeBlock.astro";

import SvelteChart from "./SvelteChart.svelte?raw";
import { format } from "./format-code";

const code = format(SvelteChart, 0);
const meta = "purple:/line(series)/ orange:/y.ticks()/ cyan:/x.domain()/";
---

<CodeBlock lang="svelte" code={code} meta={meta} />
