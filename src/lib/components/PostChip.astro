---
import type { CollectionKey } from "astro:content";

const { type, className } = Astro.props as {
  type: CollectionKey;
  className: string;
};
---

<span class:list={[`type-${type}`, className && className]}>{type}</span>

<style>
  span {
    font-family: "Atkinson Hyperlegible Mono";
    font-size: 16px;
    line-height: 1.1em;

    text-transform: capitalize;

    display: inline-flex;
    vertical-align: text-bottom;

    padding-bottom: 2px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 2px;

    margin-left: -2px;

    border-radius: 3px;

    text-shadow: none;
  }

  span.type-labs {
    background-color: var(--purple);
    color: white;
  }

  span.type-blog {
    background-color: hsl(162deg 73 34);
    color: white;
  }
</style>
