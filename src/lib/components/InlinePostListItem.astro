---
import { formatDateLong } from "$lib/utils/time";
import type { CollectionEntry } from "astro:content";
import PostChip from "./PostChip.astro";

const { post } = Astro.props as {
  post: CollectionEntry<"blog"> | CollectionEntry<"labs">;
};
---

<li>
  <a class="ignore-link-style" href={`/posts/${post.id}`}>
    <div class="type-and-title">
      <PostChip type={post.collection} />
      <h2>{post.data.title}</h2>
    </div>
    <span class="dot-separator">·</span>
    <span class="date">{formatDateLong(new Date(post.data.created))}</span>
  </a>
</li>

<style>
  li {
    margin-bottom: 16px;
    container-type: inline-size;
  }

  h2 {
    display: inline;

    font-weight: normal;
    font-size: 20px;

    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;

    transition: text-decoration-color var(--transition-blink);
  }

  a {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, max-content));
    align-items: center;

    row-gap: 4px;
    column-gap: 8px;
  }

  a:hover h2 {
    text-decoration-color: var(--blue);
  }

  .type-and-title {
    text-wrap: pretty;
  }

  .type-and-title :global(span) {
    margin-right: 3px;
    margin-bottom: -1px;
  }

  .date,
  .dot-separator {
    color: var(--text-two);
  }

  @container (width < 560px) {
    .dot-separator {
      display: none;
    }

    a {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      margin-bottom: 4px;
    }
  }
</style>
